{
  "name": "dashboard",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "app:start": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\start-dashboard.ps1",
    "app:stop": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\stop-dashboard.ps1",
    "app:status": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\status-dashboard.ps1",
    "pm2:main:start": "node .\\node_modules\\pm2\\bin\\pm2 start .\\ecosystem.config.cjs --only dashboard-main",
    "pm2:main:restart": "node .\\node_modules\\pm2\\bin\\pm2 restart dashboard-main",
    "pm2:main:stop": "node .\\node_modules\\pm2\\bin\\pm2 stop dashboard-main",
    "pm2:main:delete": "node .\\node_modules\\pm2\\bin\\pm2 delete dashboard-main",
    "pm2:main:status": "node .\\node_modules\\pm2\\bin\\pm2 status dashboard-main",
    "pm2:main:logs": "node .\\node_modules\\pm2\\bin\\pm2 logs dashboard-main --lines 100",
    "pm2:main:save": "node .\\node_modules\\pm2\\bin\\pm2 save",
    "pm2:main:resurrect": "node .\\node_modules\\pm2\\bin\\pm2 resurrect"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "concurrently": "^9.2.1",
    "pm2": "^6.0.14"
  }
}
